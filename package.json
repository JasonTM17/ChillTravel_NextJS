{
  "name": "chilltravel",
  "private": true,
  "version": "0.1.0",
  "description": "WanderViet — Full-stack Vietnam travel platform monorepo",
  "author": "Nguyen Son <nguyenson1710@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nguyenson1710/wanderviet.git"
  },
  "keywords": ["travel", "vietnam", "nestjs", "nextjs", "monorepo", "turborepo"],
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format:check": "prettier --check .",
    "docker:config": "docker compose -f infra/docker/docker-compose.yml config",
    "web:smoke": "node scripts/smoke-web.mjs",
    "seed": "pnpm --filter @vietwander/db seed",
    "ai:test": "python -m unittest discover apps/ai-service/tests",
    "e2e": "pnpm --filter @vietwander/e2e e2e",
    "generate:api-client": "node scripts/generate-api-client.mjs",
    "load-test": "k6 run load-tests/tours-list.js",
    "openapi:snapshot": "node scripts/openapi-contract-check.mjs --update",
    "openapi:check": "node scripts/openapi-contract-check.mjs",
    "prepare": "husky",
    "storybook": "pnpm --filter @vietwander/web storybook",
    "audit:baseline": "tsx scripts/audit/run-baseline.ts",
    "audit:dead-code": "tsx scripts/audit/collectors/dead-code.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.3.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.7.4",
    "ts-prune": "^0.10.3",
    "tsx": "^4.21.0",
    "turbo": "^2.6.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  }
}
