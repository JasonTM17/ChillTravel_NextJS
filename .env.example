# =============================================================================
# WanderViet Travel Platform — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://vietwander:vietwander@localhost:5432/vietwander

# ─── Cache / Queue ───────────────────────────────────────────────────────────
# Redis (used for rate limiting, session cache)
REDIS_URL=redis://localhost:6379

# ─── AI / Vector DB ──────────────────────────────────────────────────────────
# Qdrant vector database
QDRANT_URL=http://localhost:6333
# Ollama local LLM (no API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
# AI service (FastAPI)
AI_SERVICE_URL=http://localhost:8010

# ─── Authentication ───────────────────────────────────────────────────────────
# JWT secrets — use long random strings in production (min 32 chars)
JWT_ACCESS_SECRET=local_access_secret_change_me_min_32_chars
JWT_REFRESH_SECRET=local_refresh_secret_change_me_min_32_chars
# Token expiry
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Frontend ────────────────────────────────────────────────────────────────
# URL of the Next.js frontend (used for CORS and email links)
FRONTEND_URL=http://localhost:3001
# Public API URL (used by Next.js client-side code)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS (Req 4.2)
# In development, localhost origins are always allowed regardless of this setting
# Example: http://localhost:3000,https://wanderviet.com,https://www.wanderviet.com
CORS_ORIGINS=http://localhost:3001

# ─── Payment ─────────────────────────────────────────────────────────────────
# ALWAYS keep as "mock" — no real payment processing
PAYMENT_MODE=mock

# ─── File Upload ─────────────────────────────────────────────────────────────
# Local disk upload directory (relative to apps/api)
UPLOAD_DIR=uploads
# Max file size in bytes (default: 5MB)
UPLOAD_MAX_SIZE=5242880

# ─── Email ───────────────────────────────────────────────────────────────────
# Email provider: "mock" (console.log) or "smtp"
EMAIL_PROVIDER=mock
# SMTP settings (only needed if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=change_me
EMAIL_FROM=WanderViet <noreply@wanderviet.local>

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Requests per minute (default: 100 global, 5 for auth endpoints)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Secret for manual cron trigger endpoints
CRON_SECRET=local_cron_secret_change_me

# ─── Monitoring ──────────────────────────────────────────────────────────────
# Prometheus metrics endpoint (set to "false" to disable)
METRICS_ENABLED=true
# Error log file path (relative to apps/api)
ERROR_LOG_PATH=logs/errors.jsonl

# ─── Storybook ───────────────────────────────────────────────────────────────
# Storybook dev server port
STORYBOOK_PORT=6006
